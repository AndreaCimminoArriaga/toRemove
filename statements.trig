orca:ontology {
  orca:hasAssociatedKPI owl:inverseOf orca:appliesToAgent .
  
  orca:appliesToAgent owl:inverseOf orca:hasAssociatedKPI .
  
  orca:hasParticipatingAgent owl:inverseOf orca:participatesInValueChainLink .
  
  orca:participatesInValueChainLink owl:inverseOf orca:hasParticipatingAgent .
  
  orca:hasPrincipalAgent owl:inverseOf orca:belongsTo .
  
  orca:belongsTo owl:inverseOf orca:hasPrincipalAgent .
  
  orca:isComponentOf owl:inverseOf orca:hasComponent .
  
  orca:hasComponent owl:inverseOf orca:isComponentOf .
  
  orca:appliesToComponent owl:inverseOf orca:hasKPI .
  
  orca:hasKPI owl:inverseOf orca:appliesToComponent .
  
  orca:hasSubcomponent owl:inverseOf orca:isSubcomponentOf .
  
  orca:hasValueChainLink owl:inverseOf orca:isValueChainLinkOf .
  
  orca:isValueChainLinkOf owl:inverseOf orca:hasValueChainLink .
  
  orca:isElementOf owl:inverseOf orca:hasElement .
  
  orca:hasElement owl:inverseOf orca:isElementOf .
  
  orca:isSubcomponentOf owl:inverseOf orca:hasSubcomponent .
  
  orca:memberOf owl:inverseOf orca:hasMember .
  
  orca:hasMember owl:inverseOf orca:memberOf .
}

