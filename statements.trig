  ombibo:IAU_2012_Resolution_B2 dc:title "Resolution B2" .
  
  <urn:isbn:0943396611> dc:title "Astronomical Algorithms";
    dc:date "1998";
    dc:creator ombibo:Jean_Meeus .
  
  <http://www.openisbn.com/isbn/1891389459/> dc:title "Explanatory Supplement to the Astronomical Almanac";
