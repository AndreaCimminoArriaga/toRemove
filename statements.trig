  <https://orca-graph.example/resource/2137c99a-0cd6-41df-a573-9450ceecd5f6> orca:description
      "-" .
  
  <https://orca-graph.example/resource/c367afc6-6492-4dca-845c-c2fa1529b3cb> orca:description
      "-" .
  
  <https://orca-graph.example/resource/70bb979b-8b27-4603-abe9-f2c2bd511750> orca:description
      "-" .
  
  <https://orca-graph.example/resource/bc51d160-fbe3-4e52-8379-2afdb1d428c5> orca:description
      "-" .
  
  <https://orca-graph.example/resource/35e8b3f3-7bd9-4b37-9095-5e657f26d236> orca:description
      "Mide la percepción del informante sobre cómo ha evolucionado la abundancia de los recursos pesqueros en los caladeros que frecuenta o conoce, comparando su experiencia actual con la de años anteriores. Al tratarse de una percepción subjetiva basada en la observación directa y acumulada en el tiempo, no sustituye a un dato biológico objetivo, pero funciona como indicador de alerta temprana y como contraste del conocimiento ecológico tradicional sobre el estado del recurso." .
  
  <https://orca-graph.example/resource/d4a1f5f4-b986-4831-8e6c-1bff46d615ce> orca:description
      "Percepción en la variación de la temperatura durante un periodo" .
  
  <https://orca-graph.example/resource/1b3d8275-1c81-4ced-8f7d-e0030c877de3> orca:description
      "Porcentaje de pescadores que conocen y son conscientes del daño que implica el uso de artes destructivas" .
  
  <https://orca-graph.example/resource/a66008e0-2c2b-4d9d-a64b-55b79b6030e4> orca:description
      "Evaluación de la cantidad de pescadores que conocen los límites espaciales para la pesca tradicional establecidos por ley" .
  
  <https://orca-graph.example/resource/226cc7f0-5790-4785-b729-c0e78d886b3a> orca:description
      "Medir el grado de conocimiento de los pescadores sobre las restricciones referidas a las artes de pesca" .
  
  <https://orca-graph.example/resource/92e0986d-33b7-416d-b042-6f226abae8cc> orca:description
      "Mide el reconocimiento de los cierres temporales de pesca y las dimensiones legales mínimas de captura por especie objetivo." .
}

<https://orca-graph.example/graph/users/a1ea40aa-406c-4e55-b999-de4b08caa53e> {
  <https://orca-graph.example/resource/8a38003a-c4f7-4f22-88c1-5d73da3a9a18> orca:hasKPI
