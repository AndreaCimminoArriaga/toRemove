orca:ontology {
  orca:coreConcept rdfs:comment "Marks ontology classes that are required by the application and cannot be deleted."@en,
      "Marca las clases originales de la ontología que necesita la aplicación y que no se pueden borrar."@es .
  
  orca:isRelated rdfs:comment "Relación general entre dos eslabones de la cadena de valor."@es .
  
  orca:inValueChain rdfs:comment "Asigna una entidad al contexto de una cadena activa sin convertir la cadena en un nodo del grafo de trabajo."@es .
  
  orca:visibleToUsers rdfs:comment "Indicates whether a class is listed for normal users in the Definitions section."@en,
      "Indica si una clase se muestra a los usuarios normales en la sección Definiciones."@es .
  
  orca:evaluation rdfs:comment "The textual evaluation method or criteria of a KPI."@en,
      "Método o criterios textuales de evaluación de un KPI."@es .
  
  orca:code rdfs:comment "The editable textual code of a KPI."@en, "Código textual editable de un KPI."@es .
  
  orca:Element rdfs:comment "The most specific component level; it can belong to multiple subcomponents and have associated KPIs."@en,
      "Un elemento de estudio es una unidad específica de análisis que desagrega un subcomponente en aspectos concretos y observables, facilitando la evaluación detallada de la situación de la cadena de valor"@es .
  
  orca:Subcomponent rdfs:comment "A component level that can belong to multiple components and contain multiple elements."@en,
      "Unidad de análisis más específica dentro de un componente de estudio, utilizada para desagregar y evaluar con mayor detalle los diferentes aspectos que conforman dicho componente."@es .
  
  orca:isSubcomponentOf rdfs:comment "Relates a subcomponent to one of the components that contains it."@en,
      "Relaciona un subcomponente con uno de los componentes que lo contiene."@es .
  
  orca:User rdfs:comment "A platform user who may belong to one or more teams."@en,
      "Usuario de la plataforma que puede pertenecer a uno o varios equipos."@es .
  
  orca:ConsumidorFinal rdfs:comment """Persona, hogar o institución que adquiere productos pesqueros para su consumo directo, sin destinarlos a actividades de transformación, comercialización o prestación de servicios de alimentación. Constituye el último eslabón de la cadena de valor y determina la demanda final de los productos.
Incluye a:
-personas y hogares.
-instituciones y entidades que adquieren productos pesqueros para su consumo directo en el desarrollo de sus actividades, sin comercializarlos ni transformarlos para la venta.
-usuario final de los servicios de restauración que consume productos pesqueros fuera del hogar a través de establecimientos del canal HORECA, sin participar en su transformación o comercialización posterior."""@es .
  
  <https://orca-graph.example/ontology/> rdfs:label "ORCA Graph ontology"@en, "Ontología de ORCA Graph"@es .
  
  orca:SupportAgent rdfs:label "Support agent"@en, "Agentes de apoyo"@es .
  
  orca:KPI rdfs:label "Key performance indicator"@en, "Indicador clave de rendimiento (KPI)"@es .
  
  orca:ValueChainLink rdfs:label "Value-chain link"@en, "Eslabón de la cadena de valor"@es .
  
  orca:hasAssociatedKPI rdfs:label "has associated KPI"@en, "tiene KPI asociado"@es .
  
  orca:Agent rdfs:label "Agent"@en, "Agente de una cadena de valor"@es .
  
  orca:appliesToAgent rdfs:label "applies to agent"@en, "se aplica al agente"@es .
  
  orca:hasParticipatingAgent rdfs:label "has participating agent"@en, "tiene agente participante"@es .
  
  orca:AuxiliaryAgent rdfs:label "Auxiliary agent"@en, "Agentes auxiliares"@es .
  
  orca:participatesInValueChainLink rdfs:label "participates in value-chain link"@en,
      "participa en el eslabón de la cadena de valor"@es .
  
  orca:hasPrincipalAgent rdfs:label "has principal agent"@en, "tiene agente principal"@es .
  
  orca:PrincipalAgent rdfs:label "Principal agent"@en, "Agente principal"@es .
  
  orca:belongsTo rdfs:label "belongs to"@en, "pertenece"@es .
  
  orca:isComponentOf rdfs:label "is component of"@en, "es componente de"@es .
  
  orca:Component rdfs:label "Component"@en, "Componente"@es .
  
  orca:Scope rdfs:label "Scope"@en, "Ámbito"@es .
  
  orca:hasComponent rdfs:label "has component"@en, "tiene componente"@es .
  
  orca:appliesToComponent rdfs:label "applies to component"@en, "se aplica al componente"@es .
  
  orca:hasKPI rdfs:label "has KPI"@en, "tiene KPI"@es .
  
  orca:description rdfs:label "description"@en, "descripción"@es .
  
  orca:ValueChain rdfs:label "Value chain"@en, "Cadena de valor"@es .
  
  orca:hasSubcomponent rdfs:label "has subcomponent"@en, "tiene subcomponente"@es .
  
  orca:similarTo rdfs:label "similar to"@en, "similar a"@es .
  
  orca:hasValueChainLink rdfs:label "has value-chain link"@en, "tiene eslabón de cadena de valor"@es .
  
  orca:isValueChainLinkOf rdfs:label "is value-chain link of"@en, "es eslabón de la cadena de valor"@es .
  
  orca:name rdfs:label "name"@en, "nombre"@es .
}

